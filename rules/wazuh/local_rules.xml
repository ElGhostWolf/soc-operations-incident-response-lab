<group name="sigma_custom,soc_lab,">
  <rule id="100101" level="10" frequency="6" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <description>SIGMA [T1110.001]: Multiple Failed SSH Login Attempts (Brute Force)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100102" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(enc|encodedcommand)\s</field>
    <description>SIGMA [T1059.001]: Suspicious Encoded PowerShell Execution Detected</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100103" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(whoami|systeminfo)\.exe$</field>
    <description>SIGMA [T1033]: Post-Exploitation System/User Discovery</description>
    <mitre>
      <id>T1033</id>
    </mitre>
  </rule>
</group>
